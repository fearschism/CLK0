{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schema/ai-cyber-maturity-assessment-1.0.0.json",
  "title": "AI in Cybersecurity Maturity Assessment — entity export",
  "description": "One completed questionnaire for one entity, as produced by the Download JSON action on the assessment page.",
  "type": "object",
  "required": [
    "schemaVersion",
    "frameworkVersion",
    "id",
    "entity",
    "respondent",
    "period",
    "assessmentDate",
    "targetLevel",
    "answers",
    "results",
    "exportedAt"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "description": "Version of this file format.", "examples": ["1.0.0"] },
    "frameworkVersion": { "type": "string", "description": "Version of the question set used.", "examples": ["2026.1"] },
    "frameworkTitle": { "type": "string" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "description": "Stable identifier for this assessment record." },

    "entity": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "description": "Register code, e.g. E01. 'CUSTOM' for entities not on the register." },
        "name": { "type": "string" },
        "type": { "type": "string", "description": "Entity classification, e.g. Tertiary Hospital." },
        "region": { "type": "string" },
        "size": { "type": "string", "description": "Size band." }
      }
    },

    "respondent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" }
      }
    },

    "reviewedBy": { "type": "string" },
    "status": { "type": "string", "enum": ["Draft", "Submitted", "Validated"] },
    "period": { "type": "string", "description": "Assessment cycle label, e.g. 2026 H1." },
    "assessmentDate": { "type": "string", "format": "date" },
    "targetLevel": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Maturity level the governing body expects." },
    "scopeNotes": { "type": "string" },
    "generalNotes": { "type": "string" },

    "domainNotes": {
      "type": "object",
      "description": "Free-text observations keyed by domain id.",
      "propertyNames": { "pattern": "^[A-Z]{3}$" },
      "additionalProperties": { "type": "string" }
    },

    "answers": {
      "type": "object",
      "description": "One entry per question, keyed by question id such as GOV-1.",
      "propertyNames": { "pattern": "^[A-Z]{3}-[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Maturity score 0–5, or \"na\" when the control does not apply. An empty string means unanswered.",
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 5 },
              { "type": "string", "enum": ["na", ""] }
            ]
          },
          "note": { "type": "string", "description": "Evidence or justification supplied by the respondent." }
        }
      }
    },

    "results": {
      "type": "object",
      "description": "Scores computed at export time. Consumers may recompute from `answers` — the shared scoring engine is deterministic.",
      "required": ["overall", "domains", "completeness"],
      "properties": {
        "computedAt": { "type": "string", "format": "date-time" },
        "frameworkVersion": { "type": "string" },
        "targetLevel": { "type": "integer" },
        "overall": {
          "type": "object",
          "properties": {
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
            "levelName": { "type": ["string", "null"] },
            "levelDescription": { "type": ["string", "null"] },
            "color": { "type": "string" },
            "gapToTarget": { "type": ["number", "null"] }
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domainId": { "type": "string" },
              "name": { "type": "string" },
              "weight": { "type": "number", "description": "Percentage contribution to the overall score." },
              "score": { "type": ["number", "null"] },
              "percent": { "type": ["number", "null"] },
              "level": { "type": ["integer", "null"] },
              "levelName": { "type": ["string", "null"] },
              "questionsTotal": { "type": "integer" },
              "questionsScored": { "type": "integer" },
              "questionsNotApplicable": { "type": "integer" },
              "answered": { "type": "integer" },
              "complete": { "type": "boolean" }
            }
          }
        },
        "completeness": {
          "type": "object",
          "properties": {
            "answered": { "type": "integer" },
            "total": { "type": "integer" },
            "percent": { "type": "number" },
            "notApplicable": { "type": "integer" },
            "withEvidenceNotes": { "type": "integer" }
          }
        },
        "actions": {
          "type": "array",
          "description": "Improvement actions for every scored control below the target level, ranked by weighted gap.",
          "items": {
            "type": "object",
            "properties": {
              "questionId": { "type": "string" },
              "domainId": { "type": "string" },
              "domainName": { "type": "string" },
              "question": { "type": "string" },
              "action": { "type": "string" },
              "current": { "type": "number" },
              "target": { "type": "number" },
              "gap": { "type": "number" },
              "priorityScore": { "type": "number" },
              "priority": { "type": "integer", "enum": [1, 2, 3] },
              "note": { "type": "string" }
            }
          }
        },
        "priorityCounts": {
          "type": "object",
          "properties": {
            "p1": { "type": "integer" },
            "p2": { "type": "integer" },
            "p3": { "type": "integer" }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": { "type": "string" },
              "domainId": { "type": "string" },
              "domainName": { "type": "string" },
              "question": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
